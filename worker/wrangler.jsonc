{
  "name": "nexia-ai-nexus",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_SYNC",
        "class_name": "NexusSyncRoom"
      },
      {
        "name": "LOGIN_AUTH",
        "class_name": "NexusLoginRoom"
      }
    ]
  },
  "exports": {
    "NexusSyncRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "NexusLoginRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}